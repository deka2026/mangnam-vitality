# 관리자 로그인 비밀번호 (필수 — 미설정 시 개발용 기본값 + 경고 표시)
ADMIN_PASSWORD=

# 세션 서명 키 (선택 — 미설정 시 ADMIN_PASSWORD에서 파생)
SESSION_SECRET=

# Claude API 키 (선택 — 보고서→홍보글 생성, 인스타 스토리 기획에 사용)
ANTHROPIC_API_KEY=

# 알리고 문자 API (선택 — 미설정 시 발송 시뮬레이션 모드)
ALIGO_API_KEY=
ALIGO_USER_ID=
SMS_SENDER=

# 데이터 저장 경로 (선택 — 기본: ./data)
DATA_DIR=
